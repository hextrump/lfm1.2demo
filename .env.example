# URL the Streamlit app uses for the llama-server health check.
# Must match the port used by `make serve` (LLAMA_PORT below).
LLAMA_SERVER_URL=http://127.0.0.1:8080

# Where llama-server should listen.
LLAMA_PORT=8080

# llama.cpp context size for the LFM2 server.
# 8192 is a good speed/capacity balance for the 1.2B Tool model.
LLAMA_CTX=8192

# Where Streamlit should serve the demo.
STREAMLIT_PORT=8501

# Optional path to llama-server if it is not on PATH or in this folder.
LLAMA_SERVER=

# Optional path to a local GGUF model. If empty, llama-server tries to download
# LiquidAI/LFM2-1.2B-Tool-GGUF:Q4_K_M from Hugging Face (the Tool variant is
# required for reliable function/tool calling on a 1.2B model).
LFM25_GGUF_PATH=
