# Where llama-server should listen
LLAMA_PORT=8080

# llama.cpp context size for the LFM2.5 server
LLAMA_CTX=32768

# Where Streamlit should serve the demo
STREAMLIT_PORT=8501

# Optional: path to a local GGUF model. If empty, llama-server tries
# to download LiquidAI/LFM2.5-1.2B-Instruct-GGUF:Q4_K_M from Hugging Face.
LFM25_GGUF_PATH=
